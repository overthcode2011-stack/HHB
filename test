            subK.Position = UDim2.fromOffset(20, 52)
            subK.BackgroundTransparency = 1
            subK.FontFace = FONT_MAIN
            subK.TextSize = 12
            subK.TextColor3 = Colors.TextSecondary
            subK.TextXAlignment = Enum.TextXAlignment.Left
            subK.Text = isLootLabs and "LootLabs  ·  Complete tasks to unlock" or ("Provider: " .. providerName)
            subK.Parent = keyFrame

            local getKeyBtn = Instance.new("TextButton")
            getKeyBtn.Size = UDim2.new(1, -40, 0, 38)
            getKeyBtn.Position = UDim2.fromOffset(20, 85)
            getKeyBtn.BackgroundColor3 = Colors.Accent
            getKeyBtn.BorderSizePixel = 0
            getKeyBtn.FontFace = FONT_BOLD
            getKeyBtn.TextSize = 14
            getKeyBtn.TextColor3 = Colors.Background
            getKeyBtn.Text = isLootLabs and "Get Key via LootLabs" or "Get Key"
            getKeyBtn.AutoButtonColor = false
            getKeyBtn.Parent = keyFrame
            makeCorner(getKeyBtn, 9)

            getKeyBtn.MouseButton1Click:Connect(function()
                if setclipboard then pcall(function() setclipboard(API.Config.KeySystem.URL) end) end
                subK.Text = isLootLabs and "Link copied · finish the tasks then paste key" or "Link copied to clipboard"
                subK.TextColor3 = Colors.Accent
                task.delay(2.5, function()
                    if subK and subK.Parent then
                        subK.Text = isLootLabs and "LootLabs  ·  Complete tasks to unlock" or ("Provider: " .. providerName)
                        subK.TextColor3 = Colors.TextSecondary
                    end
                end)
            end)

            local keyBox = Instance.new("TextBox")
            keyBox.Size = UDim2.new(1, -40, 0, 38)
            keyBox.Position = UDim2.fromOffset(20, 133)
            keyBox.BackgroundColor3 = Colors.Surface
            keyBox.BorderSizePixel = 0
            keyBox.FontFace = FONT_CODE
            keyBox.TextSize = 14
            keyBox.TextColor3 = Colors.Text
            keyBox.PlaceholderText = "Paste key here..."
            keyBox.PlaceholderColor3 = Colors.TextSecondary
            keyBox.Text = ""
            keyBox.ClearTextOnFocus = false
            keyBox.Parent = keyFrame
            makeCorner(keyBox, 9)
            local kbPad = Instance.new("UIPadding")
            kbPad.PaddingLeft = UDim.new(0, 12)
            kbPad.Parent = keyBox

            local verifyBtn = Instance.new("TextButton")
            verifyBtn.Size = UDim2.new(1, -40, 0, 38)
            verifyBtn.Position = UDim2.fromOffset(20, 181)
            verifyBtn.BackgroundColor3 = Colors.Surface
            verifyBtn.BorderSizePixel = 0
            verifyBtn.FontFace = FONT_BOLD
            verifyBtn.TextSize = 14
            verifyBtn.TextColor3 = Colors.Text
            verifyBtn.Text = "Verify"
            verifyBtn.AutoButtonColor = false
            verifyBtn.Parent = keyFrame
            makeCorner(verifyBtn, 9)
            makeStroke(verifyBtn, Colors.Stroke, 1, 0.4)

            local keyValidated = false
            verifyBtn.MouseButton1Click:Connect(function()
                local input = keyBox.Text:gsub("%s", "")
                if input == "" then
                    subK.Text = "Please enter a key"
                    subK.TextColor3 = Color3.fromRGB(255, 90, 90)
                    return
                end
                if input == API.Config.KeySystem.ExpectedKey then
                    if hasFileSystem then pcall(function() writefile("replicatedscripts/key.ode", input) end) end
                    subK.Text = "Success · Loading..."
                    subK.TextColor3 = Colors.Accent
                    task.wait(0.8)
                    if keyFrame and keyFrame.Parent then keyFrame:Destroy() end
                    keyValidated = true
                else
                    subK.Text = "Invalid key"
                    subK.TextColor3 = Color3.fromRGB(255, 90, 90)
                    local orig = keyFrame.Position
                    TweenService:Create(keyFrame, TweenInfo.new(0.06), {Position = orig + UDim2.fromOffset(6, 0)}):Play()
                    task.wait(0.06)
                    TweenService:Create(keyFrame, TweenInfo.new(0.06), {Position = orig - UDim2.fromOffset(6, 0)}):Play()
                    task.wait(0.06)
                    TweenService:Create(keyFrame, TweenInfo.new(0.06), {Position = orig}):Play()
                end
            end)

            repeat task.wait(0.1) until keyValidated or not screenGui.Parent
            if not screenGui.Parent then return nil end
        end
