    local function getConfigFolder()
        if not hasFileSystem then return nil end
        local root = "replicatedscripts"
        if not isfolder(root) then makefolder(root) end
        local full = root .. "/Configs"
        if not isfolder(full) then makefolder(full) end
        return full
    end

    local function listConfigs()
        local out = {}
        if not hasFileSystem then return out end
        local folder = getConfigFolder()
        if not folder then return out end
        local ext = ".ode"
        local extLen = #ext
        local ok, files = pcall(function() return listfiles(folder) end)
        if ok and files then
            for _, f in ipairs(files) do
                local name = f:match("([^/\\]+)$") or f
                if name:sub(-extLen) == ext then
                    out[#out+1] = name:sub(1, #name - extLen)
                end
            end
        end
        return out
    end

