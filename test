            tabLbl.TextColor3 = Colors.TextSecondary
            tabLbl.TextXAlignment = Enum.TextXAlignment.Left
            tabLbl.Text = "in " .. entry.tab
            tabLbl.ZIndex = 53
            tabLbl.Parent = row

            row.MouseEnter:Connect(function()
                TweenService:Create(row, TweenInfo.new(0.12), {BackgroundColor3 = Colors.Hover}):Play()
            end)
            row.MouseLeave:Connect(function()
                TweenService:Create(row, TweenInfo.new(0.12), {BackgroundColor3 = Colors.Surface}):Play()
            end)
            row.MouseButton1Click:Connect(function()
