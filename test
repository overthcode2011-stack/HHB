        Players = function(includeLocal)
            local list = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if includeLocal or p ~= LocalPlayer then
                    table.insert(list, p.Name)
                end
            end
            table.sort(list)
            return list
        end,
        -- Teleport targets from a folder or workspace parts by name pattern
        Objects = function(parent, nameFilter)
            parent = parent or workspace
            local list = {}
            for _, obj in ipairs(parent:GetDescendants()) do
                if obj:IsA("BasePart") then
                    if not nameFilter or string.find(string.lower(obj.Name), string.lower(nameFilter), 1, true) then
                        table.insert(list, obj:GetFullName())
                    end
                end
            end
            table.sort(list)
            return list
        end,
