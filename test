-- Special character for privileged users (playercard + chat)
local function getSpecialDisplayName(player)
    if not player then return "" end
    local name = player.DisplayName or player.Name or ""
    if SPECIAL_IDS[player.UserId] then
        return name .. SPECIAL_CHAR
    end
    return name
end

-- Apply special character in TextChatService for privileged users
local function setupChatSpecialNames()
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            -- Modern TextChatService
            local function onIncomingMessage(message)
                local props = message.Properties or message
                local textSource = message.TextSource
                if textSource then
                    local player = Players:GetPlayerByUserId(textSource.UserId)
                    if player and SPECIAL_IDS[player.UserId] then
                        -- Prefix / suffix the special char in the message prefix if possible
                        if props.PrefixText then
                            props.PrefixText = props.PrefixText .. SPECIAL_CHAR
                        end
                    end
                end
                return message
            end
            TextChatService.OnIncomingMessage = onIncomingMessage
        end
    end)
end

