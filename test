            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then bDrag = false end
        end))

        btn.MouseButton1Click:Connect(function()
            if bMoved then bMoved = false; return end
            if config.Feature then
                local ctrl = API:GetControl(config.Feature)
                if ctrl and ctrl.SetState and ctrl.GetState then
