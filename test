local function makeAccentGradient(accent)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, accent),
        ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1):Lerp(accent, 0.45)),
        ColorSequenceKeypoint.new(1, accent),
    })
end

local function startGradientLoop(gradient, hostFrame, speed)
    speed = speed or 2.5
    task.spawn(function()
        while hostFrame and hostFrame.Parent and gradient and gradient.Parent do
            local tween = TweenService:Create(gradient, TweenInfo.new(speed, Enum.EasingStyle.Linear), {Rotation = 360})
            tween:Play()
            tween.Completed:Wait()
            if not (hostFrame and hostFrame.Parent and gradient and gradient.Parent) then break end
            gradient.Rotation = 0
        end
    end)
end

