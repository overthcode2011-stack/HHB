            if hit then
                table.insert(matches, entry)
            end
        end

        for _, entry in ipairs(matches) do
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, -8, 0, 38)
            row.BackgroundColor3 = Colors.Background
            row.BackgroundTransparency = 0.4
