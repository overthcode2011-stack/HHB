        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 34)
        b.Position = UDim2.fromOffset(0, 22)
        b.BackgroundColor3 = Colors.Surface
        b.BorderSizePixel = 0
        b.FontFace = FONT_MAIN
        b.TextSize = 13
        b.TextColor3 = Colors.Text
        b.Text = tostring(default or (options and options[1]) or "")
        b.AutoButtonColor = false
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.ClipsDescendants = false
        b.ZIndex = 10
        b.Parent = c
        makeCorner(b, 8)
        makeStroke(b, Colors.Stroke, 1, 0.45)

        local bPad = Instance.new("UIPadding")
        bPad.PaddingLeft = UDim.new(0, 12)
        bPad.Parent = b

        local arrowIcon = Instance.new("ImageLabel")
        arrowIcon.Size = UDim2.fromOffset(12, 12)
        arrowIcon.Position = UDim2.new(1, -24, 0.5, -6)
        arrowIcon.BackgroundTransparency = 1
        arrowIcon.Image = DROPDOWN_ARROW_ICON
        arrowIcon.ImageColor3 = Colors.TextSecondary
        arrowIcon.ZIndex = 11
        arrowIcon.Parent = b

        local MAX_HEIGHT = 180
        local ITEM_HEIGHT = 30
        local ITEM_PAD = 3

        local function calcListHeight(count)
            return math.min(math.max(count, 0) * (ITEM_HEIGHT + ITEM_PAD) + 8, MAX_HEIGHT)
        end

        local list = Instance.new("ScrollingFrame")
        list.Name = "HHDropdownList"
        list.Position = UDim2.new(0, 0, 1, 4)
        list.Size = UDim2.new(1, 0, 0, 0)
        list.BackgroundColor3 = Colors.Panel
        list.BorderSizePixel = 0
        list.Visible = false
        list.ZIndex = 500
        list.ClipsDescendants = true
        list.ScrollBarThickness = 3
        list.ScrollBarImageColor3 = Colors.Accent
        list.CanvasSize = UDim2.new(0, 0, 0, 0)
        list.Parent = b
        makeCorner(list, 8)
        makeStroke(list, Colors.Stroke, 1, 0.4)

        local listPad = Instance.new("UIPadding")
        listPad.PaddingTop = UDim.new(0, 4)
        listPad.PaddingBottom = UDim.new(0, 4)
        listPad.Parent = list

        local currentOptions = type(options) == "table" and options or {}
        local sel = default or currentOptions[1] or ""
        local isOpen = false
        local closeToken = 0
        local optionButtons = {}

        local function closeDropdown()
            if not isOpen then return end
            isOpen = false
            closeToken += 1
            local myToken = closeToken
            if not list or not list.Parent then return end
            TweenService:Create(list, TweenInfo.new(0.16, Enum.EasingStyle.Quint), {
                Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1
            }):Play()
            TweenService:Create(arrowIcon, TweenInfo.new(0.16), {Rotation = 0}):Play()
            task.delay(0.18, function()
                if not isOpen and closeToken == myToken and list and list.Parent then
                    list.Visible = false
                end
            end)
        end
        table.insert(openDropdowns, closeDropdown)

        local function styleOptionButton(ob, opt)
            if tostring(opt) == tostring(sel) then
                ob.BackgroundColor3 = Colors.Accent
                ob.BackgroundTransparency = 0.15
                ob.TextColor3 = Colors.Background
            else
                ob.BackgroundColor3 = Colors.Surface
                ob.BackgroundTransparency = 0
                ob.TextColor3 = Colors.Text
            end
        end

        local function clearOptionButtons()
            for _, ob in ipairs(optionButtons) do
                if ob and ob.Parent then pcall(function() ob:Destroy() end) end
            end
            optionButtons = {}
            for _, child in ipairs(list:GetChildren()) do
                if child:IsA("TextButton") then pcall(function() child:Destroy() end) end
            end
        end

        local function makeOptionButton(opt, i)
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1, -8, 0, ITEM_HEIGHT)
            ob.Position = UDim2.new(0, 4, 0, 4 + ((i - 1) * (ITEM_HEIGHT + ITEM_PAD)))
            ob.BorderSizePixel = 0
            ob.FontFace = FONT_MAIN
            ob.TextSize = 13
            ob.Text = tostring(opt)
            ob.AutoButtonColor = false
            ob.ZIndex = 501
            ob.Parent = list
            makeCorner(ob, 6)
            styleOptionButton(ob, opt)

            ob.MouseEnter:Connect(function()
                if tostring(ob.Text) ~= tostring(sel) then
                    TweenService:Create(ob, TweenInfo.new(0.12), {
                        BackgroundColor3 = Colors.Accent,
                        BackgroundTransparency = 0.4,
                        TextColor3 = Colors.Text
                    }):Play()
                end
            end)
            ob.MouseLeave:Connect(function()
                if tostring(ob.Text) ~= tostring(sel) then
                    TweenService:Create(ob, TweenInfo.new(0.12), {
                        BackgroundColor3 = Colors.Surface,
                        BackgroundTransparency = 0,
                        TextColor3 = Colors.Text
                    }):Play()
                end
            end)

            ob.MouseButton1Click:Connect(function()
                sel = opt
                b.Text = tostring(opt)
                for _, ch in ipairs(optionButtons) do styleOptionButton(ch, ch.Text) end
                closeDropdown()
                if cb then pcall(cb, sel) end
            end)
            return ob
        end

        local function rebuildOptions(newOptions)
            clearOptionButtons()
            currentOptions = type(newOptions) == "table" and newOptions or {}
            local count = #currentOptions
            list.CanvasSize = UDim2.new(0, 0, 0, count * (ITEM_HEIGHT + ITEM_PAD) + 8)
            for i, opt in ipairs(currentOptions) do
                table.insert(optionButtons, makeOptionButton(opt, i))
            end
            for _, d in ipairs(reg.dropdowns) do
                if d[1] == b then d[3] = optionButtons; break end
            end
            if isOpen and list.Visible then
                list.Size = UDim2.new(1, 0, 0, calcListHeight(count))
            end
        end

        rebuildOptions(currentOptions)
        register(reg.dropdowns, { b, list, optionButtons, function() return sel end, arrowIcon })

        b.MouseEnter:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Colors.Hover}):Play()
        end)
        b.MouseLeave:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Colors.Surface}):Play()
        end)

        b.MouseButton1Click:Connect(function()
            if not list or not list.Parent then return end
            if isOpen then closeAllDropdowns(); return end
            closeAllDropdowns()
            if not isUIUsable() then return end

            local count = #optionButtons
            local h = calcListHeight(count)
            list.CanvasSize = UDim2.new(0, 0, 0, count * (ITEM_HEIGHT + ITEM_PAD) + 8)

            isOpen = true
            closeToken += 1
            list.Size = UDim2.new(1, 0, 0, 0)
            list.BackgroundTransparency = 1
            list.Visible = true
            TweenService:Create(list, TweenInfo.new(0.22, Enum.EasingStyle.Quint), {
                Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 0
            }):Play()
            TweenService:Create(arrowIcon, TweenInfo.new(0.2), {Rotation = 180}):Play()
        end)

        addElement(tab, c)
        if tooltip then attachTooltip(b, tooltip) end
        registerSearchEntry(text, tooltip or "", tab.Name, b, function() window:SelectTab(tab) end)

        local ctrl = {
            __Name = text,
            SetValue = function(v)
                if v == nil then return end
                sel = v
                b.Text = tostring(v)
                for _, ch in ipairs(optionButtons) do styleOptionButton(ch, ch.Text) end
                if cb then pcall(cb, sel) end
            end,
            GetValue = function() return sel end,
            GetOptions = function() return currentOptions end,
            SetOptions = function(newOptions) rebuildOptions(newOptions) end,
        }
        ctrl.Refresh = ctrl.SetOptions
        NamedControls[text] = ctrl
        return ctrl
    end

