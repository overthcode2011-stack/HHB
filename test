local function getSpecialDisplayName(player)
    if not player then return "" end
    local name = player.DisplayName or player.Name or ""
    if SPECIAL_IDS[player.UserId] then
        return name .. SPECIAL_CHAR
    end
    return name
end

local function setupChatSpecialNames()
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService.OnIncomingMessage = function(message)
                local src = message.TextSource
                if src then
                    local plr = Players:GetPlayerByUserId(src.UserId)
                    if plr and SPECIAL_IDS[plr.UserId] then
                        local props = message.Properties
                        if props and props.PrefixText then
                            props.PrefixText = props.PrefixText .. SPECIAL_CHAR
                        end
                    end
                end
                return message
            end
        end
    end)
end
