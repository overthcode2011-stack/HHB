    -- ══════════════════════════════════════
    -- Creator Disconnect System
    -- Keyword that Roblox chat rarely filters
    -- ══════════════════════════════════════
    local KICK_PREFIX = "hhx·"
    local function generateKickToken()
        local chars = "abcdefghjkmnpqrstuvwxyz23456789"
        local t = ""
        for i = 1, 5 do
            local idx = math.random(1, #chars)
            t = t .. chars:sub(idx, idx)
        end
        return t
    end

    -- All hubs listen for kick messages
    task.spawn(function()
        pcall(function()
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                TextChatService.MessageReceived:Connect(function(msg)
                    local body = msg.Text or ""
                    if body:sub(1, #KICK_PREFIX) == KICK_PREFIX then
                        local payload = body:sub(#KICK_PREFIX + 1)
                        local targetName, token = payload:match("^([^:]+):(.+)$")
                        if targetName and string.lower(targetName) == string.lower(LocalPlayer.Name) then
                            if not isCreator then
                                -- Non-creators get disconnected
                                if NotifyImpl then NotifyImpl("Session terminated by creator") end
                                task.wait(0.4)
                                if window and window.Destroy then window.Destroy() end
                                if screenGui then screenGui:Destroy() end
                            end
                        end
                    end
                end)
            end
        end)
    end)

    function window:CreatorDisconnect(targetUsername)
        if not isCreator then
            if NotifyImpl then NotifyImpl("Only creators can use this") end
            return false
        end
        if not targetUsername or targetUsername == "" then return false end
        local token = generateKickToken()
        local msg = KICK_PREFIX .. targetUsername .. ":" .. token
        -- Send via TextChat if possible
        pcall(function()
            local channel = TextChatService.TextChannels and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                channel:SendAsync(msg)
            end
        end)
        if NotifyImpl then NotifyImpl("Disconnect signal sent → " .. targetUsername) end
        return true
    end

