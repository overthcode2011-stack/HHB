function API:CreateWindow(title, subtitle)
    local function randomGuiName()
        local names = {"BubbleChat","ChatWindow","PlayerList","SystemMenu","Notification","RobloxLoading","GamepadMenu","TouchGui"}
        return names[math.random(1, #names)] .. tostring(math.random(1000, 9999))
    end

    if #API.Config.SupportedGames > 0 then
        local isSupported = false
        for _, id in ipairs(API.Config.SupportedGames) do
            if id == game.PlaceId then isSupported = true; break end
        end
        if not isSupported then
            warn("[Happy Hub] This game is not supported.")
            return nil
        end
    end

    screenGui = Instance.new("ScreenGui")
    screenGui.Name = randomGuiName()
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 0
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false
    screenGui.Enabled = true

    if syn and syn.protect_gui then pcall(function() syn.protect_gui(screenGui) end)
    elseif protect_gui then pcall(function() protect_gui(screenGui) end) end

    local hostParent
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then hostParent = hui end
    end
    if not hostParent then hostParent = game:GetService("CoreGui") end
    screenGui.Parent = hostParent

    -- ── Key System ───────────────────────
    if API.Config.KeySystem.Enabled then
        local savedKey = nil
        if hasFileSystem and isfile("replicatedscripts/key.ode") then
            pcall(function() savedKey = readfile("replicatedscripts/key.ode") end)
        end

        if savedKey ~= API.Config.KeySystem.ExpectedKey then
            local providerName = tostring(API.Config.KeySystem.Provider or "Key System")
            local isLootLabs = string.lower(providerName):find("loot") ~= nil

            local keyFrame = Instance.new("Frame")
            keyFrame.Size = UDim2.fromOffset(340, 240)
            keyFrame.Position = UDim2.new(0.5, -170, 0.5, -120)
            keyFrame.BackgroundColor3 = Colors.Background
            keyFrame.BorderSizePixel = 0
            keyFrame.Parent = screenGui
            makeCorner(keyFrame, 14)
            makeStroke(keyFrame, Colors.Accent, 1.5, 0.3)

            local accentLine = Instance.new("Frame")
            accentLine.Size = UDim2.new(1, 0, 0, 3)
            accentLine.BackgroundColor3 = Colors.Accent
            accentLine.BorderSizePixel = 0
            accentLine.Parent = keyFrame
            makeCorner(accentLine, 2)

            local titleK = Instance.new("TextLabel")
            titleK.Size = UDim2.new(1, -40, 0, 28)
            titleK.Position = UDim2.fromOffset(20, 22)
            titleK.BackgroundTransparency = 1
            titleK.FontFace = FONT_BOLD
            titleK.TextSize = 18
            titleK.TextColor3 = Colors.Text
            titleK.TextXAlignment = Enum.TextXAlignment.Left
            titleK.Text = "Authentication"
