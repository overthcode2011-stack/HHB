function API:CreateWindow(title, subtitle)
    local function randomGuiName()
        local names = {
            "BubbleChat", "ChatWindow", "PlayerList",
            "SystemMenu", "Notification", "RobloxLoading",
            "GamepadMenu", "TouchGui"
        }
        return names[math.random(1, #names)] .. tostring(math.random(1000, 9999))
    end

    -- 1. Check if Game is Supported
    if #API.Config.SupportedGames > 0 then
        local isSupported = false
        for _, id in ipairs(API.Config.SupportedGames) do
            if id == game.PlaceId then 
                isSupported = true 
                break 
            end
        end
        if not isSupported then
            warn("[Happy Hub] This game is not supported.")
            return nil
        end
    end

    screenGui = Instance.new("ScreenGui")
    screenGui.Name = randomGuiName()
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 0
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false
    screenGui.Enabled = true

    if syn and syn.protect_gui then
        pcall(function() syn.protect_gui(screenGui) end)
    elseif protect_gui then
        pcall(function() protect_gui(screenGui) end)
    end

    local hostParent
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then hostParent = hui end
    end
    if not hostParent then
        hostParent = game:GetService("CoreGui")
    end
    screenGui.Parent = hostParent

    -- 2. Loading Screen & Key System
    if API.Config.KeySystem.Enabled then
        local savedKey = nil
        if hasFileSystem and isfile("replicatedscripts/key.ode") then
            pcall(function() savedKey = readfile("replicatedscripts/key.ode") end)
        end

        if savedKey ~= API.Config.KeySystem.ExpectedKey then
            local loadFrame = Instance.new("Frame")
            loadFrame.Size = UDim2.new(0, 200, 0, 60)
            loadFrame.Position = UDim2.new(0.5, -100, 0.5, -30)
            loadFrame.BackgroundColor3 = Colors.Panel
            loadFrame.BackgroundTransparency = 0.1
            loadFrame.BorderSizePixel = 0
            loadFrame.Parent = screenGui
            makeCorner(loadFrame, 6)
            
            local loadStroke = Instance.new("UIStroke")
            loadStroke.Color = Colors.Accent
            loadStroke.Thickness = 1
            loadStroke.Parent = loadFrame
            
            local loadTxt = Instance.new("TextLabel")
            loadTxt.Size = UDim2.new(1, 0, 1, 0)
            loadTxt.BackgroundTransparency = 1
            loadTxt.FontFace = FONT_MAIN
            loadTxt.TextSize = 14
            loadTxt.TextColor3 = Colors.Text
            loadTxt.Text = "Loading Happy Hub..."
            loadTxt.Parent = loadFrame
            
            local loadDots = Instance.new("TextLabel")
            loadDots.Size = UDim2.new(1, 0, 0, 20)
