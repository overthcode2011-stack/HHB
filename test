            dragging = false
        end
    end))

    globalClickConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local mousePos = input.Position
            local clickedInside = false
            for _, obj in ipairs(screenGui:GetDescendants()) do
                if obj.Name == "HHDropdownList" and obj.Visible then
                    local abs, size = obj.AbsolutePosition, obj.AbsoluteSize
                    if mousePos.X >= abs.X and mousePos.X <= abs.X + size.X and mousePos.Y >= abs.Y and mousePos.Y <= abs.Y + size.Y then
                        clickedInside = true; break
                    end
                end
            end
            if not clickedInside then closeAllDropdowns() end
        end
    end)

