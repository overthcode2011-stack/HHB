    -- Player3D Preview (ViewportFrame + WorldModel)
    -- ══════════════════════════════════════
    function window:CreatePlayer3D(tab, config)
        config = config or {}
        local rigType = config.RigType or "R15" -- "R15" or "R6"
        local height = config.Height or 180
        local userId = config.UserId or LocalPlayer.UserId

        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, -24, 0, height)
        holder.BackgroundColor3 = Colors.Surface
        holder.BorderSizePixel = 0
        holder.ZIndex = 3
        makeCorner(holder, 10)
        makeStroke(holder, Colors.Stroke, 1, 0.45)
        register(reg.panels, holder)

        local vp = Instance.new("ViewportFrame")
        vp.Size = UDim2.new(1, -8, 1, -8)
        vp.Position = UDim2.fromOffset(4, 4)
        vp.BackgroundColor3 = Colors.Background
        vp.BorderSizePixel = 0
        vp.ZIndex = 4
        vp.Parent = holder
        makeCorner(vp, 8)

        local world = Instance.new("WorldModel")
        world.Parent = vp

        local cam = Instance.new("Camera")
        cam.Parent = vp
        vp.CurrentCamera = cam

        local character = nil
        local function loadCharacter(uid, rig)
            if character then character:Destroy() end
            local desc
            local ok, err = pcall(function()
                desc = Players:GetHumanoidDescriptionFromUserId(uid)
            end)
            if not ok or not desc then return end

            local model = Instance.new("Model")
            model.Name = "PreviewAvatar"
            model.Parent = world

            -- Simple dummy: use CreateHumanoidModelFromDescription when available
            local ok2, humanoidModel = pcall(function()
                return Players:CreateHumanoidModelFromDescription(desc, rig == "R6" and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15)
            end)
            if ok2 and humanoidModel then
                humanoidModel.Parent = world
                character = humanoidModel
                local hrp = humanoidModel:FindFirstChild("HumanoidRootPart") or humanoidModel.PrimaryPart
                if hrp then
                    cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.5, 5), hrp.Position + Vector3.new(0, 1, 0))
                end
            end
        end

        task.spawn(function()
            loadCharacter(userId, rigType)
        end)

        addElement(tab, holder)

        return {
            Frame = holder,
            Viewport = vp,
            WorldModel = world,
            SetUserId = function(uid)
                userId = uid
                loadCharacter(uid, rigType)
            end,
            SetRigType = function(rig)
                rigType = rig
                loadCharacter(userId, rig)
            end,
            Reload = function()
                loadCharacter(userId, rigType)
            end,
        }
    end

