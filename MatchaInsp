local combatSettings = {
    Enabled = false, SilentAim = false, FOV = 150, Smoothing = 0.35,
    WallCheck = false, MaxDistance = 150, Target = "Head", ShowFOV = false,
    TeamCheck = false, RotateRig = true, TriggerBot = false, TriggerRange = 150,
    AutoFire = false, MatchOnly = false,
}
local visualSettings = { ESP = false, Boxes = true, Names = true, Distances = true, Health = false, Tracers = false, Fullbright = false, NoFog = false }
local movementSettings = { Fly = false, FlySpeed = 60, Noclip = false, InfJump = false, God = false }
local miscSettings = { AntiAFK = false }

